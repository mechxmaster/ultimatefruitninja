<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.UltimateFruitNinja" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="android:statusBarColor">@color/wood_dark</item>
        <item name="android:navigationBarColor">@color/wood_dark</item>
        <item name="android:windowBackground">@color/wood_dark</item>
    </style>

    <style name="Theme.UltimateFruitNinja.Fullscreen" parent="Theme.UltimateFruitNinja">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
